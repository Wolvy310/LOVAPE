# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=LOVAPE

# Security
SESSION_SECRET=replace_with_a_minimum_32_char_secret
ADMIN_PASSWORD=replace_with_a_strong_admin_password
AGE_GATE_COOKIE_DAYS=30

# Database (Step B)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lovape?schema=public

# Analytics (MVP opt-in only)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=none

# Email provider (disabled by default in MVP)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com

